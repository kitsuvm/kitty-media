[
  {
    "label": "Debug server",
    "build": {
      "command": "cargo",
      "args": ["build", "--bin=kitty-media"]
    },
    "env": {
      "KITTY_MEDIA_LOG": "kitty_media=debug",
      "KITTY_MEDIA_DATABASE_URL": "sqlite://test-data/task-queue.db?mode=rwc"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/kitty-media",
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB"
  },
  {
    "label": "Debug client",
    "build": {
      "command": "cargo",
      "args": ["build", "--bin=kitty-media-test"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/kitty-media-test",
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB"
  }
]
